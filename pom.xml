<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ==================== Parent ==================== -->
    <!-- Spring Boot 3.4.4: Latest stable 3.x release with full Java 21 support.
         The parent POM manages dependency versions via its BOM, so we don't specify
         versions for spring-boot-starter-* dependencies below. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- ==================== Project Coordinates ==================== -->
    <groupId>com.assignment</groupId>
    <artifactId>financial-transaction-processor</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>financial-transaction-processor</name>
    <description>High Throughput Financial Transaction Processor — Spring Boot Assignment</description>

    <!-- ==================== Properties ==================== -->
    <properties>
        <!-- Java 21: Required by assignment. Enables virtual threads, record patterns,
             sealed classes, and other modern language features. -->
        <java.version>21</java.version>

        <!-- JaCoCo: Latest stable version with full Java 21 bytecode support. -->
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <!-- ==================== Dependencies ==================== -->
    <dependencies>

        <!-- Spring Boot Web: Provides embedded Tomcat, Spring MVC, REST support.
             Required for the POST /api/v1/transactions/process endpoint. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA + Hibernate: ORM layer for Account and Transaction entities.
             Handles repository abstraction, JPQL, pessimistic locking, and pagination. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation (Hibernate Validator): Declarative request validation using
             annotations like @NotNull, @Positive, @Valid on DTOs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- H2 Database: In-memory SQL database for development and testing.
             Runs with MODE=PostgreSQL to simulate production behavior. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok: Eliminates boilerplate — generates getters, setters, builders,
             constructors, equals/hashCode, and toString at compile time. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== Test Dependencies ==================== -->

        <!-- Spring Boot Test: Bundles JUnit 5, Mockito, Spring Test, AssertJ,
             and MockMvc for controller, service, and repository testing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ==================== Build Configuration ==================== -->
    <build>
        <plugins>

            <!-- Spring Boot Maven Plugin: Packages the application as an executable JAR.
                 Excludes Lombok from the final artifact since it's a compile-time-only tool. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- JaCoCo: Code coverage instrumentation and reporting.
                 - prepare-agent: Instruments bytecode before tests run.
                 - report: Generates HTML/XML coverage report after tests complete.
                 Report output: target/site/jacoco/index.html -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Compiler Plugin: Configures Java 21 source/target and
                 registers Lombok as an annotation processor. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
